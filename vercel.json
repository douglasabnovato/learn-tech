{
  "rewrites": [
    { "source": "/conheca", "destination": "/conheca/index.html" },
    {
      "source": "/(programs|trilhas|privacy|terms|careers|aprender|blogs|softskills|mentorias|resources|about|falaae|category)",
      "destination": "/index.html"
    },
    { "source": "/blog/:id", "destination": "/index.html" },
    { "source": "/program/:category/:id", "destination": "/index.html" },
    { "source": "/program/:category/:id/enroll", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
